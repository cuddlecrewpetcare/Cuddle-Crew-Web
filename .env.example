# Provider-specific write gate. Keep false for routine local development and every automated test.
RESEND_SEND_ENABLED=false
# Optional local integration: server-only Resend secret. A key alone cannot enable delivery.
RESEND_API_KEY=
# Optional local integration: server-only calendar URL. Leave blank for the safe fallback.
PRIVATE_CALENDAR_ICS_URL=
# Optional local integration: configure BOTH Turnstile values or leave BOTH blank.
TURNSTILE_SECRET_KEY=
# Intentionally browser-public site key; never put the secret in a NEXT_PUBLIC variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local/test indexing control. Keep false for ordinary development and previews.
SITE_INDEXING_ENABLED=false
# Optional local integration: both server-only mapping values are required together.
GOOGLE_MAPS_SERVER_KEY=
PRIVATE_SERVICE_ORIGIN=
