# Server-only secrets. Never commit real values.
RESEND_API_KEY=
PRIVATE_CALENDAR_ICS_URL=
# Optional Cloudflare Turnstile. Configure BOTH values or leave BOTH blank.
TURNSTILE_SECRET_KEY=
# Safe public site key. The secret above remains server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Keep false while the site is private/unlisted for review.
SITE_INDEXING_ENABLED=false
# Optional privacy-safe address checker. Both server-only values are required.
GOOGLE_MAPS_SERVER_KEY=
PRIVATE_SERVICE_ORIGIN=
# Optional browser-restricted key for a future direct Maps JS integration; not used by the server proxy.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
