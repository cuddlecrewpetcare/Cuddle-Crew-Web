{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "start:e2e": "vinext start --port=3100",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "e2e": "npm run build && npm run e2e:run",
    "e2e:run": "node scripts/run-e2e.mjs",
    "test:e2e": "npm run e2e",
    "doctor": "node scripts/local-env.mjs doctor",
    "env:summary": "node scripts/local-env.mjs summary",
    "setup:local": "node scripts/local-env.mjs setup",
    "scan:secrets": "node scripts/secret-scan.mjs current",
    "scan:secrets:history": "node scripts/secret-scan.mjs history",
    "check:git-safety": "node scripts/git-safety.mjs",
    "check:integrations": "node scripts/integration-safety.mjs",
    "check:resources": "node --experimental-strip-types scripts/resource-safety.mjs",
    "check:cross-platform": "node scripts/cross-platform-check.mjs",
    "check:time": "node --experimental-strip-types scripts/time-safety.mjs",
    "validate": "npm run check:git-safety && npm run check:supply-chain && npm run check:integrations && npm run check:resources && npm run check:cross-platform && npm run check:time && npm run scan:secrets && npm run test && npm run typecheck && npm run lint && npm run build",
    "validate:full": "npm run validate && npm run e2e:run",
    "check": "npm run validate",
    "clean:generated": "node scripts/clean-generated.mjs",
    "check:supply-chain": "node scripts/supply-chain.mjs check",
    "deps:summary": "node scripts/supply-chain.mjs summary",
    "audit:dependencies": "node scripts/supply-chain.mjs audit-production",
    "audit:dependencies:all": "node scripts/supply-chain.mjs audit-all"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.20",
    "leaflet": "^1.9.4",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
